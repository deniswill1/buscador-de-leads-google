PORT=3000
# false para ver o navegador rodando (recomendado, ajuda a evitar bloqueio/captcha)
# true para rodar sem abrir janela do navegador
HEADLESS=false

# Project Settings > API no painel do Supabase
SUPABASE_URL=
# Project Settings > API > service_role (nunca a anon key aqui — só roda no servidor)
SUPABASE_SERVICE_ROLE_KEY=
